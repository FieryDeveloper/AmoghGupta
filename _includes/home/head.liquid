{%- comment -%}
  Shared <head> for the standalone pages (home, 404). These pages do not use an
  al_folio_core layout, so everything they need is declared here.
{%- endcomment -%}
{% include metadata.liquid %}
<link rel="canonical" href="{{ page.url | replace: 'index.html', '' | absolute_url }}">
<meta name="theme-color" content="#07080a">
<meta name="color-scheme" content="dark">
<link rel="icon" type="image/svg+xml" href="{{ '/assets/img/favicon.svg' | relative_url }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@1&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap"
>
<style>
  {% include home/styles.css %}
</style>
<script>
  document.documentElement.classList.add('js');
</script>
